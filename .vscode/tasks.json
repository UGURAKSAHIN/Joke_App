{
  "version": "2.0.0",
  "tasks": [
    {
      "label": "Serve Joke App",
      "type": "shell",
      "command": "py",
      "args": [
        "-3",
        "-m",
        "http.server",
        "4173",
        "--bind",
        "127.0.0.1"
      ],
      "options": {
        "cwd": "${workspaceFolder}"
      },
      "isBackground": true,
      "problemMatcher": {
        "owner": "python",
        "pattern": {
          "regexp": "^(.*)$"
        },
        "background": {
          "activeOnStart": true,
          "beginsPattern": "^.*$",
          "endsPattern": "Serving HTTP on .* port 4173"
        }
      }
    }
  ]
}
